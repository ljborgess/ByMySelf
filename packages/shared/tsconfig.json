{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // consumers import this package by its built entry, so the emit has to
    // carry both the JS and the types package.json advertises
    "module": "commonjs",
    "moduleResolution": "node10",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"]
}
