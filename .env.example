NODE_ENV=development
PORT=3100
# quantos proxies reversos ficam na frente da API. 0 em dev (conexao direta);
# 1 em producao atras do Dokploy. Sem isso o rate limit por IP vira um balde
# unico compartilhado por todo mundo — ver docs/ambiente-dev.md
TRUST_PROXY_HOPS=0
# porta do Postgres no host; 5434 evita o 5432 que todo projeto local disputa
POSTGRES_PORT=5434
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/portfolio
# minimo de 32 caracteres cada — gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# limites do RNF-SEG4: access ate 15m, refresh entre 7d e 30d
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d
COOKIE_DOMAIN=localhost
FRONTEND_URL=http://localhost:3101
SENTRY_DSN=
