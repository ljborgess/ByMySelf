NODE_ENV=development
PORT=3100
# quantos proxies reversos ficam na frente da API. 0 em dev (conexao direta);
# 1 em producao atras do Dokploy. Sem isso o rate limit por IP vira um balde
# unico compartilhado por todo mundo — ver docs/ambiente-dev.md
TRUST_PROXY_HOPS=0
# origem exata, sem barra final e sem caminho: o CORS compara literalmente com
# o header Origin do browser, que nunca traz barra. Em producao tem que ser
# https
FRONTEND_URL=http://localhost:3101
# onde o site publico (Next.js) busca a API em SSR -- ver apps/web/lib/projects.ts
API_URL=http://localhost:3100
# fine-grained Personal Access Token, "Public Repositories (read-only)", sem
# permissoes extras -- ver docs/decisao-projetos-github-pins.md
GITHUB_TOKEN=
# usuario do GitHub cujos pinned repos aparecem em /projetos
GITHUB_USERNAME=
SENTRY_DSN=
