NODE_ENV=development
PORT=3100
# quantos proxies reversos ficam na frente da API. 0 em dev (conexao direta);
# 1 em producao atras do Dokploy. Sem isso o rate limit por IP vira um balde
# unico compartilhado por todo mundo — ver docs/ambiente-dev.md
TRUST_PROXY_HOPS=0
# porta do Postgres no host; 5434 evita o 5432 que todo projeto local disputa
POSTGRES_PORT=5434
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/portfolio
# minimo de 32 caracteres cada — gere com: openssl rand -base64 48
#
# Precisam ser DIFERENTES entre si: e a separacao entre os dois que impede um
# access token capturado de servir para forjar um refresh. Iguais, o app
# recusa subir.
#
# Em producao, gere valores novos — nao reaproveite os de dev nem os de CI.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# limites do RNF-SEG4: access ate 15m, refresh entre 7d e 30d
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d
# host puro, sem esquema, porta ou caminho — vai direto no atributo Domain do
# cookie, e com qualquer um deles o browser descarta o cookie sem avisar
COOKIE_DOMAIN=localhost
# origem exata, sem barra final e sem caminho: o CORS compara literalmente com
# o header Origin do browser, que nunca traz barra. Em producao tem que ser
# https, porque o cookie de auth e Secure
FRONTEND_URL=http://localhost:3101
# onde o site publico (Next.js) busca a API em SSR -- ver apps/web/lib/projects.ts
API_URL=http://localhost:3100
SENTRY_DSN=
